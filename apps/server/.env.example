# 复制为 .env 并按需修改
PORT=8787

# Gemini 配置（不填则启用 MOCK 模式，返回写死的演示流，方便前端无 KEY 联调）
GEMINI_API_KEY=
# 可选模型（免费层限额从低到高排列）：
#
#   模型名称                        适用场景                    免费限额（约）
#   ─────────────────────────────── ─────────────────────────── ──────────────────────
#   gemini-2.5-pro                  复杂逻辑、大规模代码分析      5 RPM / 100 RPD
#   gemini-2.5-flash                平衡速度与能力（推荐）        10-15 RPM / 250-1000 RPD
#   gemini-2.0-flash                上一代快速模型               10-15 RPM / 250-1000 RPD
#
GEMINI_MODEL=gemini-2.5-flash

# 可选：网络/代理相关（在无法直连 Google 网络时使用）
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_MS=30000
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# 持久化方式：memory（默认） | sqlite
STORAGE=memory
SQLITE_PATH=./.data/sessions.db

# CORS 允许的来源（逗号分隔），开发期建议保持通配
CORS_ORIGIN=*
